# Secrets for the mcp-gateway container.
#
# TRUST BOUNDARY: the goal here is that the agent NEVER sees these values. This container holds
# the credential and exposes it only through narrow, purpose-built tools
# in gateway/server.js -- the agent can invoke a tool, but can't read the
# secret behind it. Put guarded secrets here: anything where you want to
# control precisely what the agent can do with it (read-only scopes,
# specific endpoints, rate-limited actions), rather than handing over the
# raw credential.

# Placeholder for the example third-party API tool in gateway/server.js.
# Swap this (and the tool) for a real credential/API when you add one.
EXAMPLE_API_KEY=example_third_party_api_key_here
