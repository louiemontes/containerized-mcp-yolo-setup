# Secrets for the claude-code (agent) container.
#
# TRUST BOUNDARY: the agent runs with --dangerously-skip-permissions and
# full tool access. Anything you put in here, the agent can read, print,
# exfiltrate, or use to take any action the credential itself allows.
# Only put secrets here that you're fine giving the agent maximum
# opportunity with -- e.g. a fine-grained PAT scoped to exactly the
# repos/permissions you'd let an overeager intern loose on.
#
# If a secret is more sensitive than that, it does NOT belong here --
# put it in gateway.env instead and expose it through a narrow tool in
# gateway/server.js.

# From https://console.anthropic.com/settings/keys -- required to run Claude Code.
ANTHROPIC_API_KEY=sk-ant-...

# Fine-grained PAT, scoped to only the repos/permissions the agent needs.
# Egress is gated by squid.conf (github.com/api.github.com/codeload/raw only).
AGENT_GITHUB_TOKEN=fine_grained_pat_here
